# Copy to .env for local development; Bun loads it automatically.
# Every variable without a default is required: the server refuses to start
# and lists everything missing. See src/config.ts.

# Optional: HTTP listen port. Default: 3000.
# PORT=3000

# Postgres connection string (BACKEND_DESIGN.md §2). dbmate needs
# sslmode=disable to reach a local server without TLS.
DATABASE_URL=postgres://turnip:turnip@localhost:5432/turnip?sslmode=disable

# Optional, tests only: a migrated database for the database tests. Each test
# rolls back, so the local database above is fine.
# TEST_DATABASE_URL=postgres://turnip:turnip@localhost:5432/turnip?sslmode=disable

# Cloudflare R2 bucket holding pose blobs and model artifacts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# iOS app bundle ID: the `aud` of Sign in with Apple identity tokens and the
# client_id for Apple's token endpoints (BACKEND_DESIGN.md §7.1).
APP_BUNDLE_ID=

# The farm's Sign in with Apple key, from the Apple Developer account
# (Certificates, Identifiers & Profiles > Keys). APPLE_PRIVATE_KEY is the
# .p8 file's PEM contents; on one line, write its newlines as \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# AES-256-GCM key for stored Apple refresh tokens: 32 random bytes, base64.
# Generate with: openssl rand -base64 32
APPLE_REFRESH_TOKEN_KEY=

# Pre-shared service key the training pipeline sends as a Bearer token to
# POST /api/models and GET /api/labels/export (BACKEND_DESIGN.md §7.1).
TURNIP_PIPELINE_KEY=

# Optional: reverse proxies, besides loopback, whose X-Forwarded-For the
# per-IP rate limits read through (BACKEND_DESIGN.md §7.2). Comma-separated
# addresses and CIDR ranges, such as a container network's subnet. Trusting
# a range trusts everything that can connect from it.
# TRUSTED_PROXIES=172.18.0.0/16
