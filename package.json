{
  "name": "turnip-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun run build-server && bun run build-client",
    "build-client": "vite build",
    "build-server": "bun ./src/pack.ts",
    "dev": "bun run dev-client & bun run dev-server",
    "dev-client": "vite",
    "dev-server": "bun --watch src/index.ts",
    "start": "bun run build && bun run start-server",
    "start-server": "bun ./build/server/bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "dbmate --no-dump-schema migrate",
    "db:rollback": "dbmate --no-dump-schema rollback",
    "db:status": "dbmate status",
    "db:new": "dbmate new",
    "moderation:source-account": "bun scripts/source-account.ts",
    "moderation:block": "bun scripts/block-account.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.0.4",
    "@vitejs/plugin-react": "^4.2.0",
    "dbmate": "2.36.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "typescript": "^7.0.2",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
