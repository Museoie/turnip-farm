{
  "name": "turnip-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "dbmate --no-dump-schema migrate",
    "db:rollback": "dbmate --no-dump-schema rollback",
    "db:status": "dbmate status",
    "db:new": "dbmate new"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "dbmate": "2.36.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
